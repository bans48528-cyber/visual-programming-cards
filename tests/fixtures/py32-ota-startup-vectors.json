     ],"expected":{"ok":false,"error_code":"FAULT"}},
    {"name":"ir_slots_disagree",
     "samples":[
       {"session_id":"startup-A","monotonic_ms":1000,"seq":21,"opcode":4,"result":0,"data":[0,25,26,25,60,15,0]},
       {"session_id":"startup-A","monotonic_ms":1500,"seq":22,"opcode":4,"result":0,"data":[0,25,26,25,60,15,0]}
     ],"expected":{"ok":false,"error_code":"IR"}},
    {"name":"ir_outside_normalized_range",
     "samples":[
       {"session_id":"startup-A","monotonic_ms":1000,"seq":21,"opcode":4,"result":0,"data":[0,101,101,101,60,15,0]},
       {"session_id":"startup-A","monotonic_ms":1500,"seq":22,"opcode":4,"result":0,"data":[0,101,101,101,60,15,0]}
     ],"expected":{"ok":false,"error_code":"IR"}},
    {"name":"invalid_product_mode",
     "samples":[
       {"session_id":"startup-A","monotonic_ms":1000,"seq":21,"opcode":4,"result":0,"data":[5,25,25,25,60,15,0]},
       {"session_id":"startup-A","monotonic_ms":1500,"seq":22,"opcode":4,"result":0,"data":[5,25,25,25,60,15,0]}
     ],"expected":{"ok":false,"error_code":"MODE"}},
    {"name":"query_rejected",
     "samples":[
       {"session_id":"startup-A","monotonic_ms":1000,"seq":21,"opcode":4,"result":0,"data":[0,25,25,25,60,15,0]},
       {"session_id":"startup-A","monotonic_ms":1500,"seq":22,"opcode":4,"result":3,"data":[0,25,25,25,60,15,0]}
     ],"expected":{"ok":false,"error_code":"DEVICE_REPLY"}},
    {"name":"wrong_reply_opcode",
     "samples":[
       {"session_id":"startup-A","monotonic_ms":1000,"seq":21,"opcode":4,"result":0,"data":[0,25,25,25,60,15,0]},
       {"session_id":"startup-A","monotonic_ms":1500,"seq":22,"opcode":51,"result":0,"data":[0,25,25,25,60,15,0]}
     ],"expected":{"ok":false,"error_code":"PROTOCOL"}},
    {"name":"one_sample_only",
     "samples":[
       {"session_id":"startup-A","monotonic_ms":1000,"seq":21,"opcode":4,"result":0,"data":[0,25,25,25,60,15,0]}
     ],"expected":{"ok":false,"error_code":"SAMPLES"}}
  ]
}
